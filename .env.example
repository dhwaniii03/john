NODE_ENV=development
PORT=3030
HOST=localhost

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=roadlife
DATABASE=roadlife

JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here

# Upstash Redis (Recommended - serverless, zero docker/local redis required)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Redis & Location WebSocket Settings (Legacy TCP / Fallback)
REDIS_URL=redis://127.0.0.1:6379
REDIS_TLS=false
LOCATION_SOCKET_ENABLED=false
LOCATION_HTTP_USES_REDIS=false
CORS_ORIGIN=*

# Test Environment Overrides
TEST_REDIS_URL=redis://127.0.0.1:6379
TEST_DB_NAME=roadlife_test

# HTTP Location Deprecation & Sunset Configuration (Must be set deliberately)
HTTP_LOCATION_DEPRECATION_AT=@1800000000
HTTP_LOCATION_SUNSET_AT=Thu, 01 Jul 2027 00:00:00 GMT

# Location Breadcrumb History Retention
JOURNEY_LOCATIONS_RETENTION_DAYS=60

# Transactional Email (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="RoadLife <onboarding@resend.dev>"

# OTP Security Settings
OTP_EXPIRY_MINUTES=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5